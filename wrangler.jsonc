{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arialink",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "arialink"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arialink",
      "database_id": "556bcc28-6e1b-4733-b88f-90fbc7242642",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}