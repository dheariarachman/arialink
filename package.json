{
  "name": "arialink", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "next dev --webpack", "build": "next build --webpack", "start": "next start",
    "test": "node --test tests/*.test.mjs", "check": "node scripts/check.mjs", "test:browser": "node tests/browser-server.mjs",
    "cf:build": "opennextjs-cloudflare build", "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && npm run cf:deploy:built",
    "cf:deploy:built": "opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply arialink-db --local",
    "db:remote": "wrangler d1 migrations apply arialink-db --remote"
  },
  "dependencies": { "next": "16.4.3", "react": "19.3.1", "react-dom": "19.3.1", "@opennextjs/cloudflare": "1.20.13" },
  "devDependencies": { "wrangler": "^4.36.0" }
}

