{
  "name": "arialink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser-server.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && npm run cf:deploy:built",
    "cf:deploy:built": "opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply arialink --local",
    "db:remote": "wrangler d1 migrations apply arialink --remote"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
